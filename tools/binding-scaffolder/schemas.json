{
  "description": "Zod schemas para validação de entrada - binding-scaffolder-agent",
  "version": "1.0",
  "schemas": {
    "adapter": {
      "type": "object",
      "properties": {
        "artefato": {
          "type": "string",
          "enum": ["adapter"],
          "required": true
        },
        "nome": {
          "type": "string",
          "pattern": "^[a-z-]+$",
          "minLength": 3,
          "maxLength": 50,
          "required": true,
          "description": "Nome do adapter em kebab-case (ex: mobile-stack, database-stack)"
        },
        "applyTo": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\*\\*.*\\.\\w+$"
          },
          "required": true,
          "description": "Glob patterns para aplicar adapter (ex: ['**/*.swift', '**/*.kt'])"
        },
        "descrição": {
          "type": "string",
          "minLength": 10,
          "maxLength": 200,
          "required": true,
          "description": "Descrição clara do adapter"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "required": false,
          "description": "Escopo do adapter (ex: ['Entities', 'Services', 'Tests'])"
        }
      },
      "required": ["artefato", "nome", "applyTo", "descrição"]
    },
    "projeto": {
      "type": "object",
      "properties": {
        "artefato": {
          "type": "string",
          "enum": ["projeto"],
          "required": true
        },
        "nome": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
          "minLength": 3,
          "maxLength": 60,
          "required": true,
          "description": "Nome do projeto em kebab-case (ex: my-awesome-project)"
        },
        "tipo": {
          "type": "string",
          "enum": ["backend", "frontend"],
          "required": true,
          "description": "Tipo do projeto"
        },
        "extends": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["backend-stack", "frontend-stack"]
          },
          "required": true,
          "description": "Adapters que este projeto estende"
        },
        "descrição": {
          "type": "string",
          "minLength": 10,
          "maxLength": 200,
          "required": true,
          "description": "Descrição do projeto"
        }
      },
      "required": ["artefato", "nome", "tipo", "extends", "descrição"]
    },
    "skill": {
      "type": "object",
      "properties": {
        "artefato": {
          "type": "string",
          "enum": ["skill"],
          "required": true
        },
        "nome": {
          "type": "string",
          "pattern": "^[a-z-]+$",
          "required": true
        },
        "tier": {
          "type": "string",
          "enum": ["core", "advanced"],
          "required": true
        },
        "descrição": {
          "type": "string",
          "minLength": 10,
          "maxLength": 200,
          "required": true
        }
      },
      "required": ["artefato", "nome", "tier", "descrição"]
    }
  },
  "validation_rules": {
    "nome_unico": "Verificar se 'nome' já existe em catalog.yaml[artefatos existentes]",
    "extends_existe": "Validar que cada item em 'extends' existe em catalog.yaml[adapters] ou [skills]",
    "applyTo_valido": "Validar glob patterns usando globstar syntax (sem erros obvious)",
    "tipo_compativel": "Se tipo=frontend, extends deve conter frontend-stack. Se tipo=backend, extends deve conter backend-stack"
  }
}

